    "Don’t know the translation? I’ll handle it for you": {
      "comment": "A description of the translation field.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No sabes la traducción? Yo la traduzco por ti"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не знаешь перевод? Я переведу за тебя"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳がわからない？お任せください"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne connaissez pas la traduction ? Je m’en occupe"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역을 모르시나요? 제가 처리해 드릴게요"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennst du die Übersetzung nicht? Ich erledige das für dich"
          }
        }
      }
    },
    "Don't let your progress fade — even 2 minutes help.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No dejes que tu progreso se pierda — incluso 2 minutos ayudan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не теряй прогресс — даже 2 минуты помогут."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "せっかくの進捗を無駄にしないで — 2分でも効果があります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne laissez pas vos progrès s’évanouir — même 2 minutes aident."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행을 멈추지 마세요 — 2분이라도 도움이 돼요."
          }
        },
        "de": {
          "stringUnit": {
