    "Go to Practice for multiple choice, typing, and fill-in-the-blank quizzes. Choose your preferred direction — word to translation or vice versa.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "روح للتدريب لاختبارات اختيار وإدخال وملء فراغات. اختار الاتجاه — كلمة لترجمة أو العكس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh zu Üben für Multiple Choice, Tippen und Lückentexte. Wähle die Richtung — Wort zu Übersetzung oder umgekehrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Practice for multiple choice, typing, and fill-in-the-blank quizzes. Choose your preferred direction — word to translation or vice versa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a Práctica para tests de opción múltiple, escritura y rellenar huecos. Elige la dirección — palabra a traducción o al revés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Va dans Entraînement pour des quiz à choix, saisie et textes à trous. Choisis le sens — mot vers traduction ou l’inverse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai a Esercizi per quiz a scelta multipla, digitazione e completa. Scegli la direzione — parola a traduzione o viceversa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
