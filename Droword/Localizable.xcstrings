    "A full week of learning! %lld words and counting.": {
      "comment": "A congratulatory message for a milestone of 30 days. The argument is the number of words in the user's vocabulary.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Una semana completa aprendiendo! %lld palabras y sumando."
