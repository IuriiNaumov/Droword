    "%lld words at %lld per week. You're becoming a true linguist.": {
      "comment": "A message congratulating the user on reaching a milestone of 100 words, with the number of words per week included.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld words at %2$lld per week. You're becoming a true linguist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld palabras a %2$lld por semana. Te estás convirtiendo en un verdadero lingüista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld слов при %2$lld в неделю. Ты становишься настоящим лингвистом."
          }
