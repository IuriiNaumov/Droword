        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai a Prática para quizzes de escolha múltipla, escrita e preenchimento. Escolhe a direção — palavra para tradução ou o inverso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейди в Практику для тестов с выбором ответа, вводом и заполнением пропусков. Выбери направление — от слова к переводу или наоборот."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
