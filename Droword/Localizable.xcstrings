    },
    "A quick review keeps words fresh. Come back?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un repaso rápido mantiene las palabras frescas. ¿Vuelves?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрое повторение помогает запоминать. Вернёшься?"
