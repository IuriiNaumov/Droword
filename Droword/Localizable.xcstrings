    "Droword" : {

    },
    "DROWORD" : {

    },
    "Droword does not use any analytics, tracking or advertising SDKs. Your usage data stays on your device." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Droword no usa ningún SDK de análisis, seguimiento o publicidad. Tus datos de uso se quedan en tu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Droword не использует никаких SDK для аналитики, отслеживания или рекламы. Данные о твоём использовании остаются на твоём устройстве."
          }
        }
      }
    },
    "Droword may send local notifications to remind you to practice. These are scheduled entirely on your device and do not involve any external service." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Droword puede enviar notificaciones locales para recordarte practicar. Se programan completamente en tu dispositivo y no implican ningún servicio externo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Droword может отправлять локальные уведомления с напоминанием о занятиях. Они планируются исключительно на твоём устройстве без участия внешних сервисов."
          }
        }
      }
    },
